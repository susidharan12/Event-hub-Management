# ═══════════════════════════════════════════════════════════════════
# EventHub Docker Compose Environment Variables
# 
# IMPORTANT: Copy this file to .env and fill in your actual values
# DO NOT commit .env to GitHub - it contains sensitive credentials!
# ═══════════════════════════════════════════════════════════════════

# PostgreSQL Configuration
POSTGRES_USER=eventhub
POSTGRES_PASSWORD=eventhub
POSTGRES_DB=eventhub

# JWT Secret (must match backend/.env JWT_SECRET)
JWT_SECRET=57ddca9eff5f10f38c7c546e4fcf6b90363544508f3a230ac405f0e865545150

# Email Configuration (for OTP and notifications)
# Using SMTP for compatibility with any email provider (SendGrid, Brevo, Mailtrap, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@eventhub.local
SMTP_SECURE=false

# Alternative: Gmail OAuth
EMAIL_USER=
EMAIL_PASSWORD=

# SMS Configuration (Twilio - optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_DEFAULT_COUNTRY=IN

# AI Service Configuration (Spring Boot - port 8080)
# Choose ONE: GROQ or ANTHROPIC
# 
# GROQ (Free tier available):
#   1. Get key from: https://console.groq.com/keys
#   2. Key format: gsk_xxxxxxxxxxxxxxxxxx
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxx
GROQ_MODEL=llama-3.3-70b-versatile

# OR use ANTHROPIC Claude (comment out GROQ_API_KEY above):
#   1. Get key from: https://console.anthropic.com/
#   2. Key format: sk-ant-xxxxxxxxxxxxxxxxxx
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Payment Service Configuration (Razorpay - Spring Boot - port 8081)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
UPI_ID=devilsusi54@oksbi
UPI_PAYEE=EventHub

# NgROK Configuration (optional - for public testing)
NGROK_AUTHTOKEN=
NGROK_URL=

# Node Environment
NODE_ENV=production
