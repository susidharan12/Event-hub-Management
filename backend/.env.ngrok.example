# NgROK Environment Configuration Template
# Copy this to .env or set these variables for ngrok deployment

# Backend Server Configuration
PORT=3000
DB_USER=postgres
DB_HOST=localhost
DB_NAME=eventhub_db
DB_PASSWORD=postgres
DB_PORT=5432

JWT_SECRET=57ddca9eff5f10f38c7c546e4fcf6b90363544508f3a230ac405f0e865545150

# NGROK CONFIGURATION - Set these for ngrok deployment
# ====================================================

# Your ngrok backend tunnel URL (starts with https://)
# Example: https://abc123def456.ngrok-free.io
NGROK_URL=

# Your ngrok authentication token (from https://dashboard.ngrok.com/get-started/your-authtoken)
NGROK_AUTHTOKEN=

# Optional: Custom domain names for ngrok tunnels (requires paid plan)
NGROK_DOMAIN=
NGROK_FRONTEND_DOMAIN=

# Optional: Comma-separated list of allowed email addresses for OAuth (e.g., user@example.com,admin@example.com)
NGROK_ALLOWED_EMAILS=

# Frontend configuration
FRONTEND_PORT=5050
FRONTEND_URL=http://localhost:5050

# If using ngrok for frontend, set this to your ngrok frontend URL
# FRONTEND_URL=https://your-frontend-domain.ngrok-free.io
